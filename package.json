{
  "name": "claude-hub",
  "version": "1.0.0",
  "description": "Central hub for syncing and managing multiple Claude Code accounts",
  "main": "dist/index.js",
  "bin": {
    "hub": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "install-cli": "npm run build && npm link",
    "uninstall-cli": "npm unlink -g claude-hub",
    "start": "node dist/index.js",
    "sync": "node dist/index.js --sync",
    "dev": "tsc --watch",
    "clean": "npx rimraf dist",
    "test": "jest",
    "test:unit": "jest --testPathPatterns=unit",
    "test:integration": "jest --testPathPatterns=integration"
  },
  "keywords": [
    "claude",
    "cli",
    "sync"
  ],
  "author": "Claude Roy",
  "license": "MIT",
  "dependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.10.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
